// HelixOS Updater backend runs passwordless for local admins. The GUI itself
// never needs root (it calls the backend via pkexec); only the headless
// backend binary is exempt, and only for active local logins in sudo.
// sudo and every other privileged action still ask normally.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/helixos-updater-backend" &&
        subject.local && subject.active && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
