#!/bin/sh
# helix-session — HelixOS graphical session: labwc compositor + Helix shell.
# The script lives as long as the compositor; ending labwc ends the session
# (logout goes through loginctl terminate-session).
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
export XDG_CURRENT_DESKTOP=Helix
export XDG_SESSION_DESKTOP=helix

labwc &
COMPOSITOR_PID=$!

# Don't launch the shell before the compositor's socket exists.
i=0
while [ "$i" -lt 100 ]; do
  if ls "$XDG_RUNTIME_DIR"/wayland-* >/dev/null 2>&1; then
    break
  fi
  sleep 0.1
  i=$((i + 1))
done

helix-shell &
SHELL_PID=$!

wait "$COMPOSITOR_PID"
